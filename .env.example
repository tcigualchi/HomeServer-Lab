APP_ENV=development
BIND_HOST=192.168.1.50
BIND_PORT=8000
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./data/homelab.db
SESSION_COOKIE_NAME=homelab_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
ADMIN_USERNAME=admin
# Gere com: python scripts/create_admin.py
ADMIN_PASSWORD_HASH=
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Integrações externas permanecem desligadas por padrão nesta instalação local.
DISCORD_ENABLED=false
MEDIA_WEB_URL=https://192.168.1.50
MEDIA_HLS_URL=https://192.168.1.50/hls
# Secrets da câmera: mantenha apenas no .env local, nunca no Git ou na URL do dashboard.
CAMERA_RTSP_USER=admin
CAMERA_RTSP_PASSWORD=
CAMERA_RTSP_HOST=192.168.1.57
CAMERA_RTSP_PATH=/onvif1
