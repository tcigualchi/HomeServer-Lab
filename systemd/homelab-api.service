[Unit]
Description=Homelab Control API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joaopc
Group=joaopc
WorkingDirectory=/home/joaopc/homelab
EnvironmentFile=/home/joaopc/homelab/.env
ExecStart=/home/joaopc/homelab/.venv/bin/uvicorn backend.app.main:app --host ${BIND_HOST} --port ${BIND_PORT}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/joaopc/homelab/data /home/joaopc/homelab/logs

[Install]
WantedBy=multi-user.target
