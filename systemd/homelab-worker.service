[Unit]
Description=Homelab Control local monitoring worker
After=homelab-api.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=joaopc
Group=joaopc
WorkingDirectory=/home/joaopc/homelab
EnvironmentFile=/home/joaopc/homelab/.env
ExecStart=/home/joaopc/homelab/.venv/bin/python -m backend.app.worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/joaopc/homelab/data /home/joaopc/homelab/logs

[Install]
WantedBy=multi-user.target
