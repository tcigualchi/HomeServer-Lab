[Unit]
Description=Homelab local camera media proxy
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/joaopc/homelab
EnvironmentFile=/home/joaopc/homelab/.env
ExecStart=/usr/bin/docker compose up -d mediamtx caddy
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
